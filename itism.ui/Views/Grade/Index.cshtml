@model IEnumerable<itism.dal.Models.Grade>

<h2>Grades</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Create</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Session</th>
            <th>Trainee</th>
            <th>Value</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var g in Model)
    {
        <tr>
            <td>@g.SessionId</td>
            <td>@g.TraineeId</td>
            <td>@g.Value</td>
            <td>
                <a asp-action="Details" asp-route-id="@g.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-warning">Edit</a>
                <form asp-action="Delete" asp-route-id="@g.Id" method="post" style="display:inline">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
    </table>


