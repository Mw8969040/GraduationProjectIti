@model BaseCourseVM

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
    <small class="form-text text-muted">Name must not contain numbers.</small>
  </div>

<div class="mb-3">
    <label asp-for="Category" class="form-label"></label>
    <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<Category>()"></select>
    <span asp-validation-for="Category" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="InstructorId" class="form-label"></label>
    <select asp-for="InstructorId" class="form-select" asp-items="ViewBag.Instructors"></select>
    <span asp-validation-for="InstructorId" class="text-danger"></span>
</div>


