@model UserVM

<h2>User Details</h2>

<div>
    <p><strong>ID:</strong> @Model.Id</p>
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Role:</strong> @Model.Role</p>
</div>

<a asp-action="GetAllUsers" class="btn btn-secondary">Back to List</a>
<a asp-action="UpdateUser" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<form asp-action="DeleteUser" method="post" asp-route-id="@Model.Id" style="display:inline">
    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
</form>
