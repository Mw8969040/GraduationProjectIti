@model itism.dal.Models.Session

<h2>Session Details</h2>

<dl class="row">
    <dt class="col-sm-2">CourseId</dt>
    <dd class="col-sm-10">@Model.CourseId</dd>
    <dt class="col-sm-2">Start</dt>
    <dd class="col-sm-10">@Model.StartDate.ToShortDateString()</dd>
    <dt class="col-sm-2">End</dt>
    <dd class="col-sm-10">@Model.EndDate.ToShortDateString()</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back</a>


