@model itism.dal.Models.Session

<h2>Create Session</h2>

<form asp-action="Create" method="post" id="sessionForm">
    <div class="mb-3">
        <label asp-for="CourseId" class="form-label">Course ID</label>
        <input asp-for="CourseId" class="form-control" />
        <span asp-validation-for="CourseId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label">Start Date</label>
        <input asp-for="StartDate" type="date" class="form-control" id="StartDate" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndDate" class="form-label">End Date</label>
        <input asp-for="EndDate" type="date" class="form-control" id="EndDate" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
        <span id="endDateError" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>


@if (ViewBag.Errors != null)
{
    <div class="alert alert-danger mt-3">
        <ul>
            @foreach (var err in ViewBag.Errors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('sessionForm').addEventListener('submit', function (e) {
            var startDateValue = document.getElementById('StartDate').value;
            var endDateValue = document.getElementById('EndDate').value;

            if (!startDateValue || !endDateValue) {
                return true; 
            }

            var startDate = new Date(startDateValue);
            var endDate = new Date(endDateValue);

            if (isNaN(startDate) || isNaN(endDate)) {
                document.getElementById('endDateError').textContent = 'Invalid date format';
                e.preventDefault();
                return false;
            }

            if (endDate <= startDate) {
                e.preventDefault();
                document.getElementById('endDateError').textContent = 'End Date must be after Start Date';
                return false;
            }

            document.getElementById('endDateError').textContent = '';
            return true;
        });
    </script>
}
